# =============================================
# 한국 수출입통계 분석 환경변수
# 이 파일을 .env 로 복사 후 값 입력
# =============================================

# 공공데이터포털 API 키 (선택)
# 발급: https://www.data.go.kr → 회원가입 → 관세청 데이터 활용신청
# 없으면 KITA 데이터로 대체 수집 (기능 일부 제한)
PUBLIC_DATA_API_KEY=your_public_data_api_key_here

# Google Gemini API 키 (AI 분석용, 필수)
# 발급: https://aistudio.google.com → Get API Key (무료)
GEMINI_API_KEY=AIzaSy_your_gemini_key_here

# 알림 설정 (선택 - 월별 리포트 이메일 발송)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
REPORT_TO_EMAIL=your_email@gmail.com
