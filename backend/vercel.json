{
  "version": 2,
  "installCommand": "pip install -r requirements-vercel.txt",
  "builds": [
    { "src": "handler.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "handler.py" }
  ],
  "crons": [
    {
      "path": "/api/internal/cron/us-morning-report",
      "schedule": "5 23 * * 0-4"
    },
    {
      "path": "/api/internal/cron/domestic-market-close",
      "schedule": "35 6 * * 1-5"
    }
  ]
}
